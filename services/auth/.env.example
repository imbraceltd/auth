PORT=3100

# ─── Deployment Mode ──────────────────────────────────────────────────────────
# Enterprise mode: set PLATFORM_SERVICE_URL to delegate auth to platform service
# Community mode:  leave unset — local user management (owner/member roles)
# PLATFORM_SERVICE_URL=https://your-platform-service.example.com/api/v1/platform/login

# ─── Storage ──────────────────────────────────────────────────────────────────
# Leave unset to use MemoryStorage (dev only — data lost on restart)
# DATABASE_TYPE=postgres|mongodb|mysql
# DATABASE_URL=postgresql://user:password@localhost:5432/imbrace
# DATABASE_NAME=imbrace  # MongoDB only

# ─── SMTP (community mode only) ───────────────────────────────────────────────
# Optional — when set, invite emails are sent automatically.
# When unset, the invite link is shown in the admin UI for manual sharing.
# SMTP_ADDRESS=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_SENDER=noreply@yourdomain.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Leave unset to disable "Continue with Google"
# Register callback URL in Google Cloud Console:
#   https://<auth-service-domain>/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Microsoft (personal accounts) ───────────────────────────────────────────
# Leave unset to disable "Continue with Microsoft"
# Register callback URL in Azure Portal:
#   https://<auth-service-domain>/microsoft/callback
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=

# ─── Azure AD (enterprise — work/school accounts) ────────────────────────────
# Leave unset to disable "Continue with Azure AD"
# Register callback URL in Azure Portal:
#   https://<auth-service-domain>/azure-ad/callback
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT=organizations  # optional, defaults to "organizations"

# ─── Keycloak ─────────────────────────────────────────────────────────────────
# Leave unset to disable "Continue with Keycloak"
# Register callback URL in Keycloak admin:
#   https://<auth-service-domain>/keycloak/callback
# KEYCLOAK_BASE_URL=https://keycloak.example.com
# KEYCLOAK_REALM=master
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
